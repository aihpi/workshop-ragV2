# --- Langflow ---
# Host port for the Langflow web UI (browser at http://localhost:${LANGFLOW_PORT})
LANGFLOW_PORT=7860
# Disables the login screen so participants can jump straight in
LANGFLOW_AUTO_LOGIN=true
# Secret used to sign session cookies. Change for any non-local deployment.
LANGFLOW_SECRET_KEY=change-me

# --- Qdrant ---
# Reachable from inside the Langflow container. On Docker Desktop and on
# Linux (with extra_hosts: host-gateway) "host.docker.internal" maps to the
# host machine where the qdrant/docker-compose.yml stack listens.
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6433
QDRANT_COLLECTION=workshop_rag

# --- Ollama ---
# Use host.docker.internal when Ollama runs on the host (native install or
# the optional ollama/docker-compose.yml stack).
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
# Tags must already be pulled with `ollama pull <tag>` on the Ollama host.
OLLAMA_LLM_MODEL=mistral:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
