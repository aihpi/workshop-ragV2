# Docker Compose runtime environment
# Copy this file to .env and adjust values:
#   cp .env.example .env

# Provider selection
#   openai: use OpenAI-compatible endpoint (e.g., LiteLLM)
#   ollama: use local Ollama instance
LLM_PROVIDER=openai

# Embedding provider
#   local: sentence-transformers in backend container (default)
#   openai: OpenAI-compatible embeddings endpoint
EMBEDDING_PROVIDER=local

# OpenAI-compatible API key
# Do not commit real keys to git.
OPENAI_API_KEY=your_api_key_here

# OpenAI-compatible base URL
# For host-based services when backend runs in Docker:
#   http://host.docker.internal:4000
OPENAI_BASE_URL=https://api.aisc.hpi.de/

# LLM model selection (important)
# Common options in this project:
#   ministral-3-14b  -> smaller/faster, lower cost
#   gpt-oss-120b     -> larger/slower, higher quality
# Set exactly one value below.
OPENAI_LLM_MODEL=ministral-3-14b
# OPENAI_LLM_MODEL=gpt-oss-120b

# Optional: only needed when EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=octen-embedding-8b
# OPENAI_EMBEDDING_DIM=4096
